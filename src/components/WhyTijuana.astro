---
// Sección "¿Por qué Tijuana?" — tarjetas de beneficios + mapa.
import { useTranslations, contact, type Lang } from '../i18n/ui';

export interface WhyCard {
  icon: string;
  tone?: 'blue' | 'savings';
  title: string;
  /** Admite <span class="feature-card__highlight"> para resaltar cifras */
  text: string;
  wide?: boolean;
}

export interface WhyData {
  id: string;
  eyebrow: string;
  heading: string;
  cards: WhyCard[];
}

interface Props { lang: Lang; data: WhyData; }
const { lang, data } = Astro.props;
const t = useTranslations(lang);
---

<section id={data.id} class="section section--white">
  <div class="container">
    <div class="section-intro psd-reveal">
      <span class="section-eyebrow">{data.eyebrow}</span>
      <h2 class="section-heading">{data.heading}</h2>
    </div>

    <div class="why-grid">
      <div class="why-cards">
        {data.cards.map((card) => (
          <div class:list={['psd-reveal', 'feature-card', card.wide && 'feature-card--wide']}>
            <div class:list={['feature-card__icon', `feature-card__icon--${card.tone ?? 'blue'}`]}>
              <span class="material-symbols-outlined">{card.icon}</span>
            </div>
            <h3 class="feature-card__title">{card.title}</h3>
            <p class="feature-card__text" set:html={card.text} />
          </div>
        ))}
      </div>

      <div class="psd-reveal">
        <div class="map-card">
          <iframe
            src={contact.mapEmbed}
            title={t('map.title')}
            loading="lazy"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <div class="map-note">
          <span class="material-symbols-outlined">directions_walk</span>
          <p set:html={t('map.note')} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why-grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: flex-start; }
  @media (min-width: 1024px) { .why-grid { grid-template-columns: 3fr 2fr; } }
  .why-cards { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 640px) { .why-cards { grid-template-columns: 1fr 1fr; } }

  .feature-card {
    background: var(--psd-bg);
    border: 1px solid var(--psd-blue-100);
    border-radius: 16px;
    padding: 24px;
  }
  .feature-card--wide { grid-column: 1 / -1; }
  .feature-card__icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .feature-card__icon--savings { background: rgba(15,157,88,0.1); }
  .feature-card__icon--savings :global(.material-symbols-outlined) { color: var(--psd-savings); }
  .feature-card__icon--blue { background: var(--psd-blue-100); }
  .feature-card__icon--blue :global(.material-symbols-outlined) { color: var(--psd-accent); }
  .feature-card__title { font-size: 18px; font-weight: 700; color: var(--psd-primary); margin: 0 0 8px; }
  .feature-card__text { font-size: 14px; color: var(--psd-text-muted); line-height: 1.6; margin: 0; }
  .feature-card__text :global(.feature-card__highlight) { font-weight: 700; color: var(--psd-savings); }

  .map-card {
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--psd-blue-100);
    box-shadow: var(--shadow-1);
  }
  .map-card iframe { width: 100%; height: 260px; border: 0; display: block; }
  @media (min-width: 1024px) { .map-card iframe { height: 288px; } }

  .map-note {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--psd-bg);
    border-radius: 12px;
    padding: 12px 16px;
    border: 1px solid var(--psd-blue-100);
  }
  .map-note :global(.material-symbols-outlined) { color: var(--psd-accent); }
  .map-note p { font-size: 14px; color: var(--psd-text-muted); margin: 0; }
  .map-note :global(strong) { color: var(--psd-primary); font-weight: 600; }
</style>
